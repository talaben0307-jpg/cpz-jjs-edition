    Event     = AddTab("Sự Kiện | Event", "🎃"),
    Premium   = AddTab("VIP | Premium", "💎"),
    Settings  = AddTab("Cài Đặt | Settings", "⚙️"),
}

local ModuleURLs = {
    Gojo      = "https://gist.githubusercontent.com/mosasaurrayan-cell/0eff78bbd7a73251ad207ee3ee0e56fa/raw/GojoTab",
    Items     = "https://gist.githubusercontent.com/nayarryanks-debug/470c951aa69a5b2099b4304ed770f4f7/raw/ItemsTab",
    AutoBlock = "https://gist.githubusercontent.com/mosasaurrayan-cell/80f16d02affcc6e8c229e621847fb0ff/raw/BlockTab",
    AllChar   = "https://gist.githubusercontent.com/mosasaurrayan-cell/09f9db6e31cf2386475f7695fc1bf064/raw/AllChars",
    M1        = "https://gist.githubusercontent.com/mosasaurrayan-cell/8e178b0f426a02d368e073849b110c8e/raw/m1tab",
    Yuji      = "https://gist.githubusercontent.com/mosasaurrayan-cell/b697f8faa6bf44283a0d4e57cf5f6a5d/raw/YujiTab",
    Haruta    = "https://gist.githubusercontent.com/mosasaurrayan-cell/c4d5d6490b928eb116d0340d74cba035/raw/HarutaTab",
    Event     = "https://gist.githubusercontent.com/mosasaurrayan-cell/69deeb8cd3065eb7196929b43ad92592/raw/Eventtab",
    Ryu       = "https://gist.githubusercontent.com/mosasaurrayan-cell/4c0c8ef2a8f8e69a9cc14e1ec46c0283/raw/Ryu",
    Yuta      = "https://gist.githubusercontent.com/mosasaurrayan-cell/b017a8730c6dd0c75d7ce9a092755422/raw/Yuta",
    OP        = "https://gist.githubusercontent.com/mosasaurrayan-cell/a556440a547500c01e4f3b1ce619bbff/raw/OpTab",
}

for key, url in pairs(ModuleURLs) do
    task.spawn(function()
        local raw = httpGet(url)
        if raw and #raw > 10 then
            local fn = loadstring(raw)
            if fn then
                local ok, mod = pcall(fn)
                if ok and mod then
                    pcall(mod, Tabs[key])
                end
            end
        end
    end)
end

local PremiumUnlocked = false
local PremiumURL = "https://gist.githubusercontent.com/nayarryanks-debug/d10421dfd315dd40d441e26b06a8c7d8/raw/PremiumTab"

Tabs.Premium:CreateSection("VIP Access | Mở Khóa Premium (Key: 0946)")
Tabs.Premium:CreateInput({
    Name = "Nhập Key Premium | Enter Key",
    PlaceholderText = "0946",
    RemoveTextAfterFocusLost = false,
    Callback = function(txt)
        if tostring(txt):gsub("%s+", "") == "0946" then
            if PremiumUnlocked then
                Notify("CPZ Menu", "Đã mở khóa Premium trước đó!", 2)
                return
            end
            PremiumUnlocked = true
            Notify("CPZ Menu", "Mở khóa VIP thành công! Đang tải tính năng...", 3)
            task.spawn(function()
                local raw = httpGet(PremiumURL)
                if raw and #raw > 10 then
                    local patched = raw:gsub(
                        'local WhitelistedUsers = { "larpercharmer", "AMLJGI" }',
                        string.format('local WhitelistedUsers = { "larpercharmer", "AMLJGI", "%s" }', LocalPlayer.Name)
                    )
                    local fn = loadstring(patched)
                    if fn then
                        local ok, mod = pcall(fn)
                        if ok and mod then pcall(mod, Tabs.Premium) end
                    end
                end
            end)
        else
            Notify("CPZ Menu", "Sai mật khẩu Premium!", 3)
        end
    end
})

local BG_DIR = "UniverseHub_BG"
local fsOk = (type(isfolder) == "function" and type(makefolder) == "function"
    and type(writefile) == "function" and type(isfile) == "function"
    and (type(getcustomasset) == "function" or type(getsynasset) == "function"))
local getAsset = getcustomasset or getsynasset

if fsOk then
    pcall(function() if not isfolder(BG_DIR) then makefolder(BG_DIR) end end)
end

local BG_PRESETS = {
    { Name = "Furina Smug",    File = "bg_furina.jpg",  Url = "https://raw.githubusercontent.com/talaben0307-jpg/autozphong/main/a59ac1fb-ba4f-4254-b6be-b14ea213ab70.jpg" },
    { Name = "Phong cảnh đêm", File = "bg_night.jpg",   Url = "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=800" },
    { Name = "Cyberpunk neon", File = "bg_neon.jpg",    Url = "https://images.unsplash.com/photo-1509198397868-475647b2a1e5?w=800" },
    { Name = "Ảnh Thắng",      File = "bg_custom1.jpg", Url = "https://raw.githubusercontent.com/talaben0307-jpg/shot-murder/main/images%20(17).jpg" },
    { Name = "Meme Hu Tao",    File = "bg_custom2.jpg", Url = "https://raw.githubusercontent.com/talaben0307-jpg/shot-murder/main/images%20(16).jpg" },
}

local function applyPreset(p)
    if not fsOk then return end
    task.spawn(function()
        local path = BG_DIR .. "/" .. p.File
        if not isfile(path) then
            local data = httpGet(p.Url)
            if data and #data > 0 then pcall(writefile, path, data) end
        end
        local ok, asset = pcall(function() return isfile(path) and getAsset(path) or "" end)
        if ok and asset and asset ~= "" then
            BgImage.Image = asset
        end
    end)
end

task.spawn(function() applyPreset(BG_PRESETS[1]) end)

Tabs.Settings:CreateSection("Background | Cài Đặt Hình Nền CPZ")
Tabs.Settings:CreateDropdown({
    Name = "Preset Background | Chọn Hình Nền",
    Options = { "Furina Smug", "Phong cảnh đêm", "Cyberpunk neon", "Ảnh Thắng", "Meme Hu Tao", "Tắt hình nền" },
    CurrentOption = "Furina Smug",
    Callback = function(sel)
        if sel == "Tắt hình nền" then
            BgImage.Image = ""
            return
        end
        for _, p in ipairs(BG_PRESETS) do
            if p.Name == sel then applyPreset(p) break end
        end
    end
})

Tabs.Settings:CreateInput({
    Name = "Custom Asset ID | Nhập ID Ảnh Roblox",
    PlaceholderText = "15906773556",
    RemoveTextAfterFocusLost = false,
    Callback = function(txt)
        local id = tostring(txt):match("%d+")
        if id then BgImage.Image = "rbxassetid://" .. id end
    end
})

Tabs.Settings:CreateSlider({
    Name = "Bg Transparency | Độ Mờ Ảnh Nền",
    Range = { 0, 1 },
    Increment = 0.05,
    CurrentValue = 0.55,
    Callback = function(v) BgImage.ImageTransparency = v end
})

Tabs.Settings:CreateSlider({
    Name = "Shade Transparency | Độ Tối Lớp Phủ",
    Range = { 0, 1 },
    Increment = 0.05,
    CurrentValue = 0.35,
    Callback = function(v) BgShade.BackgroundTransparency = v end
})

Tabs.Settings:CreateSection("Menu Controls | Điều Khiển Menu")
Tabs.Settings:CreateKeybind({
    Name = "Toggle Key | Phím Ẩn/Hiện Menu",
    Default = Enum.KeyCode.F,
    OnChange = function(k) MenuToggleKey = k end
})

Notify("CPZ Menu | Zelynx", "Đã tải thành công! Nhấn phím F hoặc nút HUB để đóng/mở.", 4)
