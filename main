local MenuToggleKey = Enum.KeyCode.F
track(UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and UserInputService:GetFocusedTextBox() == nil then
        if input.KeyCode == MenuToggleKey or input.KeyCode == Enum.KeyCode.RightShift then
            MainFrame.Visible = not MainFrame.Visible
        end
    end
end))

local fpsCount, lastFpsTime = 0, os.clock()
track(RunService.RenderStepped:Connect(function()
    fpsCount = fpsCount + 1
    local now = os.clock()
    local rot = (now * 65) % 360
    for _, g in ipairs(spinners) do
        if g and g.Parent then g.Rotation = rot end
    end
    if now - lastFpsTime >= 0.5 then
        local fps = math.floor(fpsCount / (now - lastFpsTime))
        fpsCount = 0
        lastFpsTime = now
        local ping = 0
        pcall(function() ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
        PillText.Text = string.format("⚡ CPZ Menu | JJS Edition by Zelynx | FPS: %d | Ping: %dms", fps, ping)
    end
end))

