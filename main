                create("UIStroke", { Thickness = 1, Color = Theme.Stroke }),
            })

            Btn.MouseButton1Click:Connect(function()
                TweenService:Create(Btn, TweenInfo.new(0.1), { BackgroundColor3 = Theme.AccentDim }):Play()
                task.delay(0.12, function()
                    TweenService:Create(Btn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Element }):Play()
                end)
                if callback then task.spawn(callback) end
            end)
            return Btn
        end

        function Tab:AddToggle(c, optArg)
            local cfg = type(c) == "table" and c or (type(optArg) == "table" and optArg or {})
            local name = cfg.Name or cfg.Title or cfg.Text or (type(c) == "string" and c) or "Toggle"
            local state = cfg.CurrentValue or cfg.Default or false
            local callback = cfg.Callback

            local Card = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = Theme.Element,
                BackgroundTransparency = 0.12,
                Text = "",
                AutoButtonColor = false,
                ZIndex = 3,
                Parent = Page,
            }, {
                create("UICorner", { CornerRadius = UDim.new(0, 7) }),
                create("UIStroke", { Thickness = 1, Color = Theme.Stroke }),
            })

            create("TextLabel", {
                Size = UDim2.new(1, -70, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamSemibold,
                Text = tostring(name),
                TextColor3 = Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 3,
                Parent = Card,
            })

            local Switch = create("Frame", {
                Size = UDim2.fromOffset(42, 20),
                Position = UDim2.new(1, -52, 0.5, -10),
                BackgroundColor3 = state and Theme.Accent or Theme.Off,
                ZIndex = 3,
                Parent = Card,
            }, {
                create("UICorner", { CornerRadius = UDim.new(1, 0) }),
            })

            local Knob = create("Frame", {
                Size = UDim2.fromOffset(14, 14),
                Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
                BackgroundColor3 = Color3.new(1, 1, 1),
                ZIndex = 4,
                Parent = Switch,
            }, {
                create("UICorner", { CornerRadius = UDim.new(1, 0) }),
            })

            local function setToggle(val)
                state = val
                TweenService:Create(Switch, TweenInfo.new(0.15), {
                    BackgroundColor3 = state and Theme.Accent or Theme.Off
                }):Play()
                TweenService:Create(Knob, TweenInfo.new(0.15), {
                    Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                }):Play()
                if callback then task.spawn(callback, state) end
            end

            Card.MouseButton1Click:Connect(function() setToggle(not state) end)
            return { Set = setToggle, SetValue = setToggle }
        end

