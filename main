local LocalPlayer = Players.LocalPlayer

local env = (getgenv and getgenv()) or _G
if env.UniverseCleanup then
    pcall(env.UniverseCleanup)
end

local parentGui = (gethui and gethui()) or CoreGui
local connections, cleanups, spinners = {}, {}, {}

local function track(conn)
    table.insert(connections, conn)
    return conn
end

local function onCleanup(fn)
    table.insert(cleanups, fn)
end

env.UniverseCleanup = function()
    for _, c in ipairs(connections) do
        pcall(function() c:Disconnect() end)
    end
    table.clear(connections)
    for _, fn in ipairs(cleanups) do
        pcall(fn)
    end
    table.clear(cleanups)
    table.clear(spinners)
    env.UniverseCleanup = nil
end

local requestFn = (syn and syn.request) or (http and http.request) or http_request or request

local function httpGet(url)
    if requestFn then
        local ok, res = pcall(requestFn, { Url = url, Method = "GET" })
        if ok and res and res.StatusCode == 200 and res.Body then
            return res.Body
        end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    return ok and body or nil
end

local function Notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "CPZ Menu",
            Text = text or "",
            Duration = duration or 3
        })
    end)
end

-- ===== CPZ Menu Original Theme =====
local Theme = {
    Background = Color3.fromRGB(11, 11, 18),
    Panel = Color3.fromRGB(18, 18, 28),
    PanelAlt = Color3.fromRGB(26, 22, 42),
    Element = Color3.fromRGB(26, 26, 40),
    ElementHover = Color3.fromRGB(38, 38, 58),
    Off = Color3.fromRGB(54, 54, 76),
    Stroke = Color3.fromRGB(46, 46, 68),
    Accent = Color3.fromRGB(0, 229, 255),
    AccentDim = Color3.fromRGB(0, 96, 118),
    Accent2 = Color3.fromRGB(170, 80, 255),
    Text = Color3.fromRGB(240, 240, 248),
    SubText = Color3.fromRGB(150, 150, 176),
    Danger = Color3.fromRGB(255, 70, 90),
    Good = Color3.fromRGB(70, 220, 130),
    Warn = Color3.fromRGB(255, 190, 60),
}

local ACCENT_GRADIENT = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Theme.Accent),
    ColorSequenceKeypoint.new(0.5, Theme.Accent2),
    ColorSequenceKeypoint.new(1, Theme.Accent),
})

local function create(class, props, children)
    local inst = Instance.new(class)
    if inst:IsA("GuiObject") then
        inst.BorderSizePixel = 0
    end
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then
            parent = v
        else
            inst[k] = v
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if parent then
        inst.Parent = parent
    end
    return inst
end

local function makeDraggable(handle, target, onTap)
    local dragging, dragInput, dragStart, startPos = false, nil, nil, nil
    local moved = false

    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = target.Position
        end
    end))

    track(handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end))

    track(UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then
                moved = true
                target.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end))

    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                if not moved and onTap then
                    onTap()
                end
            end
        end
    end))
end

