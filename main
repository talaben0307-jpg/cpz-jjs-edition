local UI_Settings = {
    AccentColor = Color3.fromRGB(160, 80, 255),
    BgColor = Color3.fromRGB(14, 14, 20),
    PanelColor = Color3.fromRGB(22, 22, 30),
    CardColor = Color3.fromRGB(28, 28, 38),
    TextColor = Color3.fromRGB(240, 240, 250),
    SubTextColor = Color3.fromRGB(165, 165, 185),
    BgImage = "rbxassetid://15906773556",
    BgTransparency = 0.65,
    WindowTransparency = 0.08,
    RainbowStroke = true,
    ToggleKey = Enum.KeyCode.RightShift
}

local Connections = {}
local function trackConn(c)
    table.insert(Connections, c)
    return c
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "Zelynx_CPZ_UI"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
ScreenGui.DisplayOrder = 9999
ScreenGui.Parent = guiParent

local function Notify(title, text, duration)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "JJS Edition by Zelynx",
            Text = text or "",
            Duration = duration or 3
        })
    end)
end

local function makeDraggable(dragHandle, targetFrame, onTapCallback)
    local dragging = false
    local dragInput, dragStart, startPos
    local moved = false

    dragHandle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = targetFrame.Position
        end
    end)

    dragHandle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    trackConn(UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then
                moved = true
                targetFrame.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end
    end))

    trackConn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then
                dragging = false
                if not moved and onTapCallback then
                    onTapCallback()
                end
            end
        end
    end))
end

