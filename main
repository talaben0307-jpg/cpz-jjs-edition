                PaddingRight = UDim.new(0, 6),
                PaddingBottom = UDim.new(0, 8),
            }),
        })

        local function selectTab()
            for _, t in ipairs(Window.Tabs) do
                t.Page.Visible = false
                t.Btn.BackgroundColor3 = Theme.Element
                t.Btn.BackgroundTransparency = 0.25
                t.Btn.TextColor3 = Theme.SubText
                t.Indicator.Visible = false
            end
            Page.Visible = true
            TabBtn.BackgroundColor3 = Theme.PanelAlt
            TabBtn.BackgroundTransparency = 0.05
            TabBtn.TextColor3 = Theme.Accent
            Indicator.Visible = true
        end

        TabBtn.MouseButton1Click:Connect(selectTab)
        table.insert(Window.Tabs, { Btn = TabBtn, Page = Page, Indicator = Indicator })
        if #Window.Tabs == 1 then selectTab() end

        local Tab = { Page = Page }

