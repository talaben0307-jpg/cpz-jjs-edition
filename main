-- ============================================================================
-- TAB PREMIUM 💎 (KHÓA BẰNG KEY 0946 + TỰ ĐỘNG THÊM TÊN VÀO WHITELIST)
-- ============================================================================
local PremiumUnlocked = false

Tabs.Premium:CreateSection("Bảo Mật VIP - Zelynx Edition")
Tabs.Premium:CreateInput({
    Name = "🔐 Nhập Key Premium",
    PlaceholderText = "Nhập mật khẩu (0946)...",
    RemoveTextAfterFocusLost = false,
    Callback = function(text)
        if tostring(text):gsub("%s+", "") == "0946" then
            if PremiumUnlocked then
                Notify("Premium VIP", "Tab Premium đã được mở khóa rồi!", 2)
                return
            end
            PremiumUnlocked = true
            Notify("Mở Khóa Thành Công!", "Chào mừng Zelynx! Đang nạp tính năng Premium...", 4)

            task.spawn(function()
                local mod = (function()
-- Failed to load Premium: <urlopen error [Errno -3] Temporary failure in name resolution>
                end)()
                if type(mod) == 'function' then pcall(mod, Tabs.Premium) elseif type(mod) == 'table' then pcall(mod, Tabs.Premium) end
            end)
        else
            Notify("Sai Key!", "Mật khẩu Premium không đúng!", 3)
        end
    end
})

-- ============================================================================
-- TAB CÀI ĐẶT NỀN & GIAO DIỆN (GIỮ NGUYÊN TÙY CHỈNH NỀN CPZ)
-- ============================================================================
Tabs.Settings:CreateSection("Tùy Chỉnh Hình Nền (Background)")

local BgPresets = {
    ["Gojo Purple (Mặc định)"] = "rbxassetid://15906773556",
    ["Sukuna Shrine Dark"]     = "rbxassetid://14846885125",
    ["Anime Cyber Night"]      = "rbxassetid://12974500525",
    ["Galaxy Nebula"]          = "rbxassetid://15132613786",
    ["Tắt Hình Nền"]           = ""
}

Tabs.Settings:CreateDropdown({
    Name = "Chọn Hình Nền Có Sẵn",
    Options = { "Gojo Purple (Mặc định)", "Sukuna Shrine Dark", "Anime Cyber Night", "Galaxy Nebula", "Tắt Hình Nền" },
    CurrentOption = "Gojo Purple (Mặc định)",
    Callback = function(selected)
        local asset = BgPresets[selected]
        if asset then BgImageLabel.Image = asset end
    end
})

Tabs.Settings:CreateInput({
    Name = "Nhập ID Ảnh Nền Tùy Ý",
    PlaceholderText = "VD: 15906773556 hoặc rbxassetid://...",
    RemoveTextAfterFocusLost = false,
    Callback = function(text)
        local cleanId = tostring(text):match("%d+")
        if cleanId then
            BgImageLabel.Image = "rbxassetid://" .. cleanId
            Notify("Cập Nhật Nền", "Đã đổi hình nền sang ID: " .. cleanId, 3)
        end
    end
})

Tabs.Settings:CreateSlider({
    Name = "Độ Mờ Hình Nền (Bg Transparency)",
    Range = {0, 1},
    Increment = 0.05,
    CurrentValue = UI_Settings.BgTransparency,
    Callback = function(val)
        UI_Settings.BgTransparency = val
        BgImageLabel.ImageTransparency = val
    end
})

Tabs.Settings:CreateSection("Tùy Chỉnh Khung Menu")

Tabs.Settings:CreateSlider({
    Name = "Độ Trong Suốt Khung Menu",
    Range = {0, 0.8},
    Increment = 0.05,
    CurrentValue = UI_Settings.WindowTransparency,
    Callback = function(val)
        UI_Settings.WindowTransparency = val
        MainFrame.BackgroundTransparency = val
    end
})

Tabs.Settings:CreateToggle({
    Name = "Viền Cầu Vồng (Rainbow Border)",
    CurrentValue = UI_Settings.RainbowStroke,
    Callback = function(val)
        UI_Settings.RainbowStroke = val
    end
})

Tabs.Settings:CreateColorPicker({
    Name = "Đổi Màu Chủ Đạo (Accent Color)",
    Color = UI_Settings.AccentColor,
    Callback = function(col)
        UI_Settings.AccentColor = col
        FloatBtn.TextColor3 = col
        MainStroke.Color = col
        FloatStroke.Color = col
    end
})

Tabs.Settings:CreateKeybind({
    Name = "Phím Ẩn/Hiện Menu (PC)",
    CurrentKeybind = "RightShift",
    Callback = function()
        MainFrame.Visible = not MainFrame.Visible
    end
})

