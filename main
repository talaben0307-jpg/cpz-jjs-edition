local function tr(txt)
    local s = tostring(txt or "")
    return BilingualDict[s] or s
end

local AllTabs = {}

local function AddTab(title, icon)
    local TabBtn = Instance.new("TextButton", Sidebar)
    TabBtn.Size = UDim2.new(1, 0, 0, 32)
    TabBtn.BackgroundColor3 = Theme.Element
    TabBtn.BackgroundTransparency = 0.25
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.Text = "  " .. icon .. "  " .. title
    TabBtn.TextColor3 = Theme.SubText
    TabBtn.TextSize = 11
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.AutoButtonColor = false
    TabBtn.ZIndex = 3
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 7)

    local Indicator = Instance.new("Frame", TabBtn)
    Indicator.Size = UDim2.new(0, 3, 0.6, 0)
    Indicator.Position = UDim2.new(0, 2, 0.2, 0)
    Indicator.BackgroundColor3 = Theme.Accent
    Indicator.Visible = false
    Indicator.ZIndex = 4
    Instance.new("UICorner", Indicator).CornerRadius = UDim.new(1, 0)

    local Page = Instance.new("ScrollingFrame", ContentHolder)
    Page.Size = UDim2.new(1, -16, 1, -16)
    Page.Position = UDim2.fromOffset(8, 8)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = Theme.Accent
    Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.Visible = false
    Page.ZIndex = 3

    local pLayout = Instance.new("UIListLayout", Page)
    pLayout.Padding = UDim.new(0, 6)
    pLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(0, 0, 0, pLayout.AbsoluteContentSize.Y + 14)
    end)

    local pPad = Instance.new("UIPadding", Page)
    pPad.PaddingRight = UDim.new(0, 6)
    pPad.PaddingBottom = UDim.new(0, 8)

    local function selectTab()
        for _, t in ipairs(AllTabs) do
            t.Page.Visible = false
            t.Btn.BackgroundColor3 = Theme.Element
            t.Btn.BackgroundTransparency = 0.25
            t.Btn.TextColor3 = Theme.SubText
            t.Indicator.Visible = false
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = Theme.PanelAlt
        TabBtn.BackgroundTransparency = 0.05
        TabBtn.TextColor3 = Theme.Accent
        Indicator.Visible = true
    end

    TabBtn.MouseButton1Click:Connect(selectTab)
    table.insert(AllTabs, { Btn = TabBtn, Page = Page, Indicator = Indicator })
    if #AllTabs == 1 then selectTab() end

    local Tab = {}

    function Tab:CreateSection(secName)
        local Lbl = Instance.new("TextLabel", Page)
        Lbl.Size = UDim2.new(1, 0, 0, 22)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.GothamBold
        Lbl.Text = "◆  " .. tr(type(secName) == "table" and (secName.Name or secName.Title) or secName)
        Lbl.TextColor3 = Theme.Accent
        Lbl.TextSize = 12
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.ZIndex = 3
    end

    function Tab:CreateParagraph(
        return
    end

    function Tab:CreateButton(c, fnArg)
        local cfg = type(c) == "table" and c or { Name = tostring(c), Callback = fnArg }
        local bName = tr(cfg.Name or cfg.Title or cfg.Text or "Button")
        local cb = cfg.Callback or cfg.Func or fnArg

        local Btn = Instance.new("TextButton", Page)
        Btn.Size = UDim2.new(1, 0, 0, 34)
        Btn.BackgroundColor3 = Theme.Element
        Btn.BackgroundTransparency = 0.12
        Btn.Font = Enum.Font.GothamBold
        Btn.Text = "  ▶  " .. bName
        Btn.TextColor3 = Theme.Text
        Btn.TextSize = 11
        Btn.TextXAlignment = Enum.TextXAlignment.Left
        Btn.AutoButtonColor = false
        Btn.ZIndex = 3
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 7)
        local st = Instance.new("UIStroke", Btn)
        st.Thickness = 1
        st.Color = Theme.Stroke

        Btn.MouseButton1Click:Connect(function()
            TweenService:Create(Btn, TweenInfo.new(0.1), { BackgroundColor3 = Theme.PanelAlt }):Play()
            task.delay(0.12, function()
                TweenService:Create(Btn, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Element }):Play()
            end)
            if cb then task.spawn(cb) end
        end)
        return Btn
    end

    function Tab:CreateToggle(c, optArg)
        local cfg = type(c) == "table" and c or (type(optArg) == "table" and optArg or {})
        local rawName = cfg.Name or cfg.Title or cfg.Text or (type(c) == "string" and c) or "Toggle"
        local tName = tr(rawName)
        local state = false
        local cb = cfg.Callback

        local Card = Instance.new("TextButton", Page)
        Card.Size = UDim2.new(1, 0, 0, 36)
        Card.BackgroundColor3 = Theme.Element
        Card.BackgroundTransparency = 0.12
        Card.Text = ""
        Card.AutoButtonColor = false
        Card.ZIndex = 3
        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 7)
        local st = Instance.new("UIStroke", Card)
        st.Thickness = 1
        st.Color = Theme.Stroke

        local Lbl = Instance.new("TextLabel", Card)
        Lbl.Size = UDim2.new(1, -66, 1, 0)
        Lbl.Position = UDim2.fromOffset(10, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.Text = tName
        Lbl.TextColor3 = Theme.Text
        Lbl.TextSize = 11
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.ZIndex = 3

        local Switch = Instance.new("Frame", Card)
        Switch.Size = UDim2.fromOffset(40, 20)
        Switch.Position = UDim2.new(1, -50, 0.5, -10)
        Switch.BackgroundColor3 = Theme.Off
        Switch.ZIndex = 3
        Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

        local Knob = Instance.new("Frame", Switch)
        Knob.Size = UDim2.fromOffset(14, 14)
        Knob.Position = UDim2.new(0, 3, 0.5, -7)
        Knob.BackgroundColor3 = Color3.new(1, 1, 1)
        Knob.ZIndex = 4
        Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

        local function setToggle(val)
            state = val
            TweenService:Create(Switch, TweenInfo.new(0.15), { BackgroundColor3 = state and Theme.Accent or Theme.Off }):Play()
            TweenService:Create(Knob, TweenInfo.new(0.15), { Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7) }):Play()
            if cb then task.spawn(cb, state) end
        end

        Card.MouseButton1Click:Connect(function() setToggle(not state) end)
        return { Set = setToggle, SetValue = setToggle }
    end

    function Tab:CreateSlider(c, optArg)
        local cfg = type(c) == "table" and c or (type(optArg) == "table" and optArg or {})
        local rawName = cfg.Name or cfg.Title or cfg.Text or (type(c) == "string" and c) or "Slider"
        local sName = tr(rawName)
        local range = cfg.Range or { cfg.Min or 0, cfg.Max or 100 }
        local minVal, maxVal = range[1], range[2]
        local inc = cfg.Increment or cfg.Step or (cfg.Rounding == 2 and 0.01) or (cfg.Rounding == 1 and 0.1) or 1
        local suffix = cfg.Suffix and (" " .. cfg.Suffix) or ""
        local curVal = cfg.CurrentValue or cfg.Default or minVal
        local cb = cfg.Callback

        local Card = Instance.new("Frame", Page)
        Card.Size = UDim2.new(1, 0, 0, 48)
        Card.BackgroundColor3 = Theme.Element
        Card.BackgroundTransparency = 0.12
        Card.ZIndex = 3
        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 7)
        local st = Instance.new("UIStroke", Card)
        st.Thickness = 1
        st.Color = Theme.Stroke

        local Lbl = Instance.new("TextLabel", Card)
        Lbl.Size = UDim2.new(1, -90, 0, 20)
        Lbl.Position = UDim2.fromOffset(10, 4)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.Text = sName
        Lbl.TextColor3 = Theme.Text
        Lbl.TextSize = 11
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.ZIndex = 3

        local ValLbl = Instance.new("TextLabel", Card)
        ValLbl.Size = UDim2.fromOffset(80, 20)
        ValLbl.Position = UDim2.new(1, -90, 0, 4)
        ValLbl.BackgroundTransparency = 1
        ValLbl.Font = Enum.Font.GothamBold
        ValLbl.Text = tostring(curVal) .. suffix
        ValLbl.TextColor3 = Theme.Accent
        ValLbl.TextSize = 11
        ValLbl.TextXAlignment = Enum.TextXAlignment.Right
        ValLbl.ZIndex = 3

        local BarBg = Instance.new("TextButton", Card)
        BarBg.Size = UDim2.new(1, -20, 0, 8)
        BarBg.Position = UDim2.fromOffset(10, 30)
        BarBg.BackgroundColor3 = Theme.Off
        BarBg.Text = ""
        BarBg.AutoButtonColor = false
        BarBg.ZIndex = 3
        Instance.new("UICorner", BarBg).CornerRadius = UDim.new(1, 0)

        local initAlpha = math.clamp((curVal - minVal) / math.max(0.0001, maxVal - minVal), 0, 1)
        local Fill = Instance.new("Frame", BarBg)
        Fill.Size = UDim2.new(initAlpha, 0, 1, 0)
        Fill.BackgroundColor3 = Theme.Accent
        Fill.BorderSizePixel = 0
        Fill.ZIndex = 4
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

        local sliding = false
        local function updateVal(pos)
            local relX = math.clamp((pos.X - BarBg.AbsolutePosition.X) / math.max(1, BarBg.AbsoluteSize.X), 0, 1)
            local raw = minVal + (maxVal - minVal) * relX
            local snapped = math.floor((raw / inc) + 0.5) * inc
            snapped = tonumber(string.format("%.2f", math.clamp(snapped, minVal, maxVal)))
            curVal = snapped
            Fill.Size = UDim2.new((curVal - minVal) / math.max(0.0001, maxVal - minVal), 0, 1, 0)
            ValLbl.Text = tostring(curVal) .. suffix
            if cb then task.spawn(cb, curVal) end
        end

        BarBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                updateVal(input.Position)
            end
        end)
        track(UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateVal(input.Position)
            end
        end))
        track(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end))
    end

    function Tab:CreateDropdown(c, optArg)
        local cfg = type(c) == "table" and c or (type(optArg) == "table" and optArg or {})
        local dName = tr(cfg.Name or cfg.Title or cfg.Text or "Dropdown")
        local options = cfg.Options or cfg.Values or { "None" }
        local current = cfg.CurrentOption or cfg.Default or options[1] or "None"
        if type(current) == "table" then current = current[1] end
        local cb = cfg.Callback
        local isOpen = false

        local Container = Instance.new("Frame", Page)
        Container.Size = UDim2.new(1, 0, 0, 36)
        Container.BackgroundColor3 = Theme.Element
        Container.BackgroundTransparency = 0.12
        Container.ClipsDescendants = true
        Container.ZIndex = 3
        Instance.new("UICorner", Container).CornerRadius = UDim.new(0, 7)
        local st = Instance.new("UIStroke", Container)
        st.Thickness = 1
        st.Color = Theme.Stroke

        local TopBtn = Instance.new("TextButton", Container)
        TopBtn.Size = UDim2.new(1, 0, 0, 36)
        TopBtn.BackgroundTransparency = 1
        TopBtn.Font = Enum.Font.GothamSemibold
        TopBtn.Text = "  " .. dName .. ":  [" .. tostring(current) .. "]  ▼"
        TopBtn.TextColor3 = Theme.Text
        TopBtn.TextSize = 11
        TopBtn.TextXAlignment = Enum.TextXAlignment.Left
        TopBtn.ZIndex = 3

        local OptionList = Instance.new("Frame", Container)
        OptionList.Size = UDim2.new(1, -16, 0, 0)
        OptionList.Position = UDim2.fromOffset(8, 38)
        OptionList.BackgroundTransparency = 1
        OptionList.ZIndex = 3
        local oLayout = Instance.new("UIListLayout", OptionList)
        oLayout.Padding = UDim.new(0, 4)

        local function rebuild(newOpts)
            options = newOpts or options
            for _, ch in ipairs(OptionList:GetChildren()) do
                if ch:IsA("TextButton") then ch:Destroy() end
            end
            for _, opt in ipairs(options) do
                local OBtn = Instance.new("TextButton", OptionList)
                OBtn.Size = UDim2.new(1, 0, 0, 26)
                OBtn.BackgroundColor3 = Theme.PanelAlt
                OBtn.Font = Enum.Font.GothamSemibold
                OBtn.Text = tostring(opt)
                OBtn.TextColor3 = Theme.Text
                OBtn.TextSize = 11
                OBtn.ZIndex = 4
                Instance.new("UICorner", OBtn).CornerRadius = UDim.new(0, 5)
                OBtn.MouseButton1Click:Connect(function()
                    current = opt
                    TopBtn.Text = "  " .. dName .. ":  [" .. tostring(current) .. "]  ▼"
                    isOpen = false
                    Container.Size = UDim2.new(1, 0, 0, 36)
                    if cb then task.spawn(cb, current) end
                end)
            end
            if isOpen then Container.Size = UDim2.new(1, 0, 0, 42 + (#options * 30)) end
        end

        TopBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            Container.Size = isOpen and UDim2.new(1, 0, 0, 42 + (#options * 30)) or UDim2.new(1, 0, 0, 36)
        end)
        rebuild(options)

        return {
            Refresh = function(_, newList) rebuild(newList) end,
            Set = function(_, val)
                current = val
                TopBtn.Text = "  " .. dName .. ":  [" .. tostring(current) .. "]  ▼"
                if cb then task.spawn(cb, current) end
            end
        }
    end

    function Tab:CreateKeybind(c)
        local cfg = c or {}
        local kName = tr(cfg.Name or cfg.Title or cfg.Text or "Keybind")
        local keyStr = cfg.CurrentKeybind or (typeof(cfg.Default) == "EnumItem" and cfg.Default.Name) or cfg.Default or "E"
        local currentKey = typeof(cfg.Default) == "EnumItem" and cfg.Default or (Enum.KeyCode[tostring(keyStr)] or Enum.KeyCode.E)
        local binding = false

        local Card = Instance.new("Frame", Page)
        Card.Size = UDim2.new(1, 0, 0, 36)
        Card.BackgroundColor3 = Theme.Element
        Card.BackgroundTransparency = 0.12
        Card.ZIndex = 3
        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 7)
        local st = Instance.new("UIStroke", Card)
        st.Thickness = 1
        st.Color = Theme.Stroke

        local Lbl = Instance.new("TextLabel", Card)
        Lbl.Size = UDim2.new(1, -100, 1, 0)
        Lbl.Position = UDim2.fromOffset(10, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.Text = kName
        Lbl.TextColor3 = Theme.Text
        Lbl.TextSize = 11
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.ZIndex = 3

        local KeyBtn = Instance.new("TextButton", Card)
        KeyBtn.Size = UDim2.fromOffset(76, 24)
        KeyBtn.Position = UDim2.new(1, -86, 0.5, -12)
        KeyBtn.BackgroundColor3 = Theme.PanelAlt
        KeyBtn.Font = Enum.Font.GothamBold
        KeyBtn.Text = "[" .. tostring(currentKey.Name) .. "]"
        KeyBtn.TextColor3 = Theme.Accent
        KeyBtn.TextSize = 11
        KeyBtn.ZIndex = 3
        Instance.new("UICorner", KeyBtn).CornerRadius = UDim.new(0, 5)

        KeyBtn.MouseButton1Click:Connect(function()
            binding = true
            KeyBtn.Text = "[...]"
        end)

        track(UserInputService.InputBegan:Connect(function(input, gpe)
            if binding then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                    KeyBtn.Text = "[" .. currentKey.Name .. "]"
                    binding = false
                    if cfg.OnChange then pcall(cfg.OnChange, currentKey) end
                end
                return
            end
            if not gpe and UserInputService:GetFocusedTextBox() == nil then
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey then
                    if cfg.Callback then task.spawn(cfg.Callback, currentKey) end
                end
            end
        end))
    end

    function Tab:CreateInput(c)
        local cfg = c or {}
        local iName = tr(cfg.Name or cfg.Title or cfg.Text or "Input")

        local Card = Instance.new("Frame", Page)
        Card.Size = UDim2.new(1, 0, 0, 38)
        Card.BackgroundColor3 = Theme.Element
        Card.BackgroundTransparency = 0.12
        Card.ZIndex = 3
        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 7)
        local st = Instance.new("UIStroke", Card)
        st.Thickness = 1
        st.Color = Theme.Stroke

        local Lbl = Instance.new("TextLabel", Card)
        Lbl.Size = UDim2.new(0.52, -10, 1, 0)
        Lbl.Position = UDim2.fromOffset(10, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.Text = iName
        Lbl.TextColor3 = Theme.Text
        Lbl.TextSize = 11
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.ZIndex = 3

        local Box = Instance.new("TextBox", Card)
        Box.Size = UDim2.new(0.46, -10, 0, 26)
        Box.Position = UDim2.new(0.54, 0, 0.5, -13)
        Box.BackgroundColor3 = Theme.PanelAlt
        Box.Font = Enum.Font.Gotham
        Box.PlaceholderText = tostring(cfg.PlaceholderText or "Nhập...")
        Box.PlaceholderColor3 = Theme.SubText
        Box.Text = ""
        Box.TextColor3 = Theme.Text
        Box.TextSize = 11
        Box.ClearTextOnFocus = false
        Box.ZIndex = 3
        Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 5)

        Box.FocusLost:Connect(function()
            local txt = Box.Text
            if cfg.RemoveTextAfterFocusLost then Box.Text = "" end
            if cfg.Callback then task.spawn(cfg.Callback, txt) end
        end)
    end

    function Tab:CreateColorPicker(c)
        local cfg = c or {}
        local cName = tr(cfg.Name or cfg.Title or "Color Picker")
        local colors = {
            Color3.fromRGB(255, 200, 60),
            Color3.fromRGB(0, 229, 255),
            Color3.fromRGB(185, 75, 255),
            Color3.fromRGB(70, 220, 130),
            Color3.fromRGB(240, 65, 85),
            Color3.fromRGB(255, 255, 255),
        }
        local idx = 1

        local Btn = Instance.new("TextButton", Page)
        Btn.Size = UDim2.new(1, 0, 0, 36)
        Btn.BackgroundColor3 = Theme.Element
        Btn.BackgroundTransparency = 0.12
        Btn.Font = Enum.Font.GothamSemibold
        Btn.Text = "  🎨  " .. cName
        Btn.TextColor3 = Theme.Text
        Btn.TextSize = 11
        Btn.TextXAlignment = Enum.TextXAlignment.Left
        Btn.AutoButtonColor = false
        Btn.ZIndex = 3
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 7)

        local Preview = Instance.new("Frame", Btn)
        Preview.Size = UDim2.fromOffset(20, 20)
        Preview.Position = UDim2.new(1, -30, 0.5, -10)
        Preview.BackgroundColor3 = cfg.Color or colors[1]
        Preview.ZIndex = 4
        Instance.new("UICorner", Preview).CornerRadius = UDim.new(1, 0)

        Btn.MouseButton1Click:Connect(function()
            idx = (idx % #colors) + 1
            Preview.BackgroundColor3 = colors[idx]
            if cfg.Callback then task.spawn(cfg.Callback, colors[idx]) end
        end)
    end

    Tab.AddSection = Tab.CreateSection
    Tab.AddParagraph = Tab.CreateParagraph
    Tab.AddButton = Tab.CreateButton
    Tab.AddToggle = Tab.CreateToggle
    Tab.AddSlider = Tab.CreateSlider
    Tab.AddDropdown = Tab.CreateDropdown
    Tab.AddKeybind = Tab.CreateKeybind
    Tab.AddInput = Tab.CreateInput
    Tab.AddColorPicker = Tab.CreateColorPicker
    Tab.AddLeftGroupbox = function(self, n) self:CreateSection(n) return self end
    Tab.AddRightGroupbox = function(self, n) self:CreateSection(n) return self end

    return Tab
end

env.ZelynxCPZ_Cleanup = function()
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    table.clear(connections)
    table.clear(spinners)
    pcall(function() ScreenGui:Destroy() end)
    env.ZelynxCPZ_Cleanup = nil
end

CloseBtn.MouseButton1Click:Connect(function()
    if env.ZelynxCPZ_Cleanup then env.ZelynxCPZ_Cleanup() end
end)

