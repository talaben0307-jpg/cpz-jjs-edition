            local cfg = type(c) == "table" and c or { Name = tostring(c), Callback = fnArg }
            local btnText = cfg.Name or cfg.Title or cfg.Text or "Button"
            local callback = cfg.Callback or cfg.Func or fnArg

            local Btn = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 36),
                BackgroundColor3 = Theme.Element,
                BackgroundTransparency = 0.12,
                Font = Enum.Font.GothamBold,
