    local fpsCount = 0
    local lastFpsTime = os.clock()
    track(RunService.RenderStepped:Connect(function()
        fpsCount = fpsCount + 1
        local now = os.clock()
        local rot = (now * 65) % 360
        for _, grad in ipairs(spinners) do
            if grad and grad.Parent then grad.Rotation = rot end
        end
        if now - lastFpsTime >= 0.5 then
            local fps = math.floor(fpsCount / (now - lastFpsTime))
            fpsCount = 0
            lastFpsTime = now
            local ping = 0
            pcall(function()
                ping = math.floor(StatsService.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)
            PillText.Text = string.format("⚡ %s | %s | FPS: %d | Ping: %dms", title, subTitle, fps, ping)
        end
    end))

