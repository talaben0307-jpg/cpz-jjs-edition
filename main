-- ============================================================================
-- NẠP TRỰC TIẾP 11 MODULE CÔNG KHAI VÀO CÁC TAB CỦA CPZ MENU
-- ============================================================================
local PublicModules = {
    Gojo      = "https://gist.githubusercontent.com/mosasaurrayan-cell/0eff78bbd7a73251ad207ee3ee0e56fa/raw/GojoTab",
    Items     = "https://gist.githubusercontent.com/nayarryanks-debug/470c951aa69a5b2099b4304ed770f4f7/raw/ItemsTab",
    AutoBlock = "https://gist.githubusercontent.com/mosasaurrayan-cell/80f16d02affcc6e8c229e621847fb0ff/raw/BlockTab",
    AllChar   = "https://gist.githubusercontent.com/mosasaurrayan-cell/09f9db6e31cf2386475f7695fc1bf064/raw/AllChars",
    M1        = "https://gist.githubusercontent.com/mosasaurrayan-cell/8e178b0f426a02d368e073849b110c8e/raw/m1tab",
    Yuji      = "https://gist.githubusercontent.com/mosasaurrayan-cell/b697f8faa6bf44283a0d4e57cf5f6a5d/raw/YujiTab",
    Haruta    = "https://gist.githubusercontent.com/mosasaurrayan-cell/c4d5d6490b928eb116d0340d74cba035/raw/HarutaTab",
    Event     = "https://gist.githubusercontent.com/mosasaurrayan-cell/69deeb8cd3065eb7196929b43ad92592/raw/Eventtab",
    Ryu       = "https://gist.githubusercontent.com/mosasaurrayan-cell/4c0c8ef2a8f8e69a9cc14e1ec46c0283/raw/Ryu",
    Yuta      = "https://gist.githubusercontent.com/mosasaurrayan-cell/b017a8730c6dd0c75d7ce9a092755422/raw/Yuta",
    OP        = "https://gist.githubusercontent.com/mosasaurrayan-cell/a556440a547500c01e4f3b1ce619bbff/raw/OpTab",
}

for tabKey, url in pairs(PublicModules) do
    task.spawn(function()
        local raw = httpGet(url)
        if raw and #raw > 10 then
            local fn, err = loadstring(raw)
            if fn then
                local ok, mod = pcall(fn)
                if ok and mod then
                    pcall(mod, Tabs[tabKey])
                end
            else
                warn("[CPZ Menu] Lỗi biên dịch tab " .. tabKey .. ": " .. tostring(err))
            end
        else
            Tabs[tabKey]:AddLabel("⚠️ Không thể tải dữ liệu tab " .. tabKey .. " (Kiểm tra mạng/Executor)")
        end
    end)
end

-- ============================================================================
-- TAB PREMIUM 💎 (KHÓA BẰNG KEY 0946 + TỰ ĐỘNG WHITELIST TÀI KHOẢN CỦA BẠN)
-- ============================================================================
local PremiumUnlocked = false
local PremiumURL = "https://gist.githubusercontent.com/nayarryanks-debug/d10421dfd315dd40d441e26b06a8c7d8/raw/PremiumTab"

Tabs.Premium:AddSection("Premium Access (Key: 0946)")

Tabs.Premium:AddInput({
    Name = "🔐 Nhập Key Premium",
    PlaceholderText = "Nhập mật khẩu (0946)...",
    RemoveTextAfterFocusLost = false,
    Callback = function(text)
        if tostring(text):gsub("%s+", "") == "0946" then
            if PremiumUnlocked then
                Notify("CPZ Menu", "Tab Premium đã được mở khóa rồi!", 2)
                return
            end
            PremiumUnlocked = true
            Notify("CPZ Menu", "Mở khóa Premium thành công! Đang tải tính năng...", 3)

            task.spawn(function()
                local raw = httpGet(PremiumURL)
                if raw and #raw > 10 then
                    -- Tự động thêm tên tài khoản hiện tại của bạn vào WhitelistedUsers
                    local patched = raw:gsub(
                        'local WhitelistedUsers = { "larpercharmer", "AMLJGI" }',
                        string.format('local WhitelistedUsers = { "larpercharmer", "AMLJGI", "%s" }', LocalPlayer.Name)
                    )
                    local fn = loadstring(patched)
                    if fn then
                        local ok, mod = pcall(fn)
                        if ok and mod then
                            pcall(mod, Tabs.Premium)
                        end
                    end
                end
            end)
        else
            Notify("Sai Mật Khẩu!", "Key Premium không chính xác!", 3)
        end
    end
})

-- ============================================================================
-- TAB SETTINGS ⚙️ (GIỮ NGUYÊN CÀI ĐẶT NỀN GỐC CỦA CPZ MENU)
-- ============================================================================
local tSettings = Tabs.Settings

local BG_DIR = "UniverseHub_BG"
local fsOk = (type(isfolder) == "function" and type(makefolder) == "function"
    and type(writefile) == "function" and type(isfile) == "function"
    and (type(getcustomasset) == "function" or type(getsynasset) == "function"))
local getAsset = getcustomasset or getsynasset

if fsOk then
    pcall(function()
        if not isfolder(BG_DIR) then makefolder(BG_DIR) end
    end)
end

local FURINA_URL = "https://raw.githubusercontent.com/talaben0307-jpg/autozphong/main/a59ac1fb-ba4f-4254-b6be-b14ea213ab70.jpg"

local BG_PRESETS = {
    { Name = "Furina Smug",     File = "bg_furina.jpg",  Url = FURINA_URL },
    { Name = "Phong cảnh đêm",  File = "bg_night.jpg",   Url = "https://images.unsplash.com/photo-1518709268805-4e9042af9f23?w=800" },
    { Name = "Cyberpunk neon",  File = "bg_neon.jpg",    Url = "https://images.unsplash.com/photo-1509198397868-475647b2a1e5?w=800" },
    { Name = "Ảnh Thắng",       File = "bg_custom1.jpg", Url = "https://raw.githubusercontent.com/talaben0307-jpg/shot-murder/main/images%20(17).jpg" },
    { Name = "Meme Hu Tao",     File = "bg_custom2.jpg", Url = "https://raw.githubusercontent.com/talaben0307-jpg/shot-murder/main/images%20(16).jpg" },
}

local function presetPath(p)
    return BG_DIR .. "/" .. p.File
end

local function presetAsset(p)
    if not fsOk then return "" end
    local ok, asset = pcall(function()
        if isfile(presetPath(p)) then return getAsset(presetPath(p)) end
        return ""
    end)
    return (ok and asset) or ""
end

local function downloadPreset(p, onDone)
    if not fsOk then return end
    task.spawn(function()
        if not isfile(presetPath(p)) then
            local data = httpGet(p.Url)
            if data and #data > 0 then
                pcall(writefile, presetPath(p), data)
            end
        end
        if onDone then onDone() end
    end)
end

local function applyPreset(p)
    downloadPreset(p, function()
        local asset = presetAsset(p)
        if asset ~= "" then
            Window.BgImage.Image = asset
            if fsOk then
                pcall(writefile, BG_DIR .. "/selected.txt", p.Name)
            end
        end
    end)
end

-- Tự động tải ảnh nền Furina Smug mặc định của CPZ Menu
task.spawn(function()
    local savedName = "Furina Smug"
    if fsOk and isfile(BG_DIR .. "/selected.txt") then
        local ok, r = pcall(readfile, BG_DIR .. "/selected.txt")
        if ok and r and #r > 0 then savedName = r end
    end
    for _, p in ipairs(BG_PRESETS) do
        if p.Name == savedName then
            applyPreset(p)
            break
        end
    end
end)

tSettings:AddSection("Ảnh nền (CPZ Original)")

local presetNames = {}
for _, p in ipairs(BG_PRESETS) do
    table.insert(presetNames, p.Name)
end
table.insert(presetNames, "Tắt ảnh nền")

tSettings:AddDropdown({
    Name = "Chọn Ảnh Nền",
    Options = presetNames,
    CurrentOption = "Furina Smug",
    Callback = function(selected)
        if selected == "Tắt ảnh nền" then
            Window.BgImage.Image = ""
            return
        end
        for _, p in ipairs(BG_PRESETS) do
            if p.Name == selected then
                applyPreset(p)
                break
            end
        end
    end,
})

tSettings:AddInput({
    Name = "ID / URL Ảnh Nền Tùy Chỉnh",
    PlaceholderText = "Nhập rbxassetid:// hoặc số ID...",
    RemoveTextAfterFocusLost = false,
    Callback = function(txt)
        local id = tostring(txt):match("%d+")
        if id then
            Window.BgImage.Image = "rbxassetid://" .. id
        end
    end,
})

tSettings:AddSlider({
    Name = "Độ Mờ Ảnh Nền (Bg Transparency)",
    Range = { 0, 1 },
    Increment = 0.05,
    CurrentValue = 0.45,
    Callback = function(v)
        Window.BgImage.ImageTransparency = v
    end,
})

tSettings:AddSlider({
    Name = "Độ Tối Lớp Phủ Nền (Shade)",
    Range = { 0, 1 },
    Increment = 0.05,
    CurrentValue = 0.35,
    Callback = function(v)
        Window.BgShade.BackgroundTransparency = v
    end,
})

tSettings:AddSection("Menu")

tSettings:AddKeybind({
    Name = "Phím Đóng / Mở Menu",
    Default = Enum.KeyCode.F,
    OnChange = function(newKey)
        Window:SetMenuKey(newKey)
    end,
})

tSettings:AddButton({
    Name = "Đóng Hoàn Toàn Script (Unload)",
    Callback = function()
        if env.UniverseCleanup then env.UniverseCleanup() end
    end,
})

Notify("CPZ Menu", "JJS Edition by Zelynx đã tải hoàn tất!", 4)
