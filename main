            TweenService:Create(Btn, TweenInfo.new(0.1), {BackgroundColor3 = UI_Settings.AccentColor}):Play()
            task.delay(0.12, function()
                TweenService:Create(Btn, TweenInfo.new(0.15), {BackgroundColor3 = UI_Settings.CardColor}):Play()
            end)
            if cfg.Callback then task.spawn(cfg.Callback) end
        end)
