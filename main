local AllTabs = {}
local ActiveTab = nil

local function CreateCustomTab(tabName)
    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(1, 0, 0, 32)
    TabBtn.BackgroundColor3 = UI_Settings.CardColor
    TabBtn.BackgroundTransparency = 0.3
    TabBtn.Font = Enum.Font.GothamSemibold
    TabBtn.Text = "  " .. tabName
    TabBtn.TextColor3 = UI_Settings.SubTextColor
    TabBtn.TextSize = 12
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.AutoButtonColor = false
    TabBtn.ZIndex = 3
    TabBtn.Parent = Sidebar
    Instance.new("UICorner", TabBtn).CornerRadius = UDim.new(0, 6)

    local Page = Instance.new("ScrollingFrame")
    Page.Name = tabName .. "_Page"
    Page.Size = UDim2.new(1, -12, 1, -12)
    Page.Position = UDim2.fromOffset(6, 6)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = UI_Settings.AccentColor
    Page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    Page.Visible = false
    Page.ZIndex = 3
    Page.Parent = PagesHolder

    local PageLayout = Instance.new("UIListLayout", Page)
    PageLayout.Padding = UDim.new(0, 6)
    PageLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local PagePad = Instance.new("UIPadding", Page)
    PagePad.PaddingRight = UDim.new(0, 6)
    PagePad.PaddingBottom = UDim.new(0, 6)

    local function SelectThisTab()
        for _, t in ipairs(AllTabs) do
            t.Page.Visible = false
            t.Btn.BackgroundColor3 = UI_Settings.CardColor
            t.Btn.BackgroundTransparency = 0.3
            t.Btn.TextColor3 = UI_Settings.SubTextColor
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = UI_Settings.AccentColor
        TabBtn.BackgroundTransparency = 0.1
        TabBtn.TextColor3 = Color3.new(1, 1, 1)
        ActiveTab = Page
    end

    TabBtn.MouseButton1Click:Connect(SelectThisTab)
    table.insert(AllTabs, { Btn = TabBtn, Page = Page })
    if #AllTabs == 1 then SelectThisTab() end

    local TabAPI = {}

