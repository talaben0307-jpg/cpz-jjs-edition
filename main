                Parent = Card,
            }, {
                create("UICorner", { CornerRadius = UDim.new(1, 0) }),
            })

            local initAlpha = math.clamp((curVal - minVal) / math.max(0.0001, maxVal - minVal), 0, 1)
            local Fill = create("Frame", {
                Size = UDim2.new(initAlpha, 0, 1, 0),
                BackgroundColor3 = Theme.Accent,
                ZIndex = 4,
                Parent = BarBg,
            }, {
                create("UICorner", { CornerRadius = UDim.new(1, 0) }),
            })

            local sliding = false
            local function updateVal(pos)
                local relX = math.clamp((pos.X - BarBg.AbsolutePosition.X) / math.max(1, BarBg.AbsoluteSize.X), 0, 1)
                local raw = minVal + (maxVal - minVal) * relX
                local snapped = math.floor((raw / inc) + 0.5) * inc
                snapped = tonumber(string.format("%.2f", math.clamp(snapped, minVal, maxVal)))
                curVal = snapped
                local alpha = (curVal - minVal) / math.max(0.0001, maxVal - minVal)
                Fill.Size = UDim2.new(alpha, 0, 1, 0)
                ValLbl.Text = tostring(curVal) .. suffix
                if callback then task.spawn(callback, curVal) end
            end

            BarBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = true
                    updateVal(input.Position)
                end
            end)
            track(UserInputService.InputChanged:Connect(function(input)
                if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateVal(input.Position)
                end
            end))
            track(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    sliding = false
                end
            end))
        end

        function Tab:AddDropdown(c, optArg)
            local cfg = type(c) == "table" and c or (type(optArg) == "table" and optArg or {})
            local name = cfg.Name or cfg.Title or cfg.Text or (type(c) == "string" and c) or "Dropdown"
            local options = cfg.Options or cfg.Values or { "None" }
            local current = cfg.CurrentOption or cfg.Default or options[1] or "None"
            if type(current) == "table" then current = current[1] end
            local callback = cfg.Callback
            local isOpen = false

            local Container = create("Frame", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = Theme.Element,
                BackgroundTransparency = 0.12,
                ClipsDescendants = true,
                ZIndex = 3,
                Parent = Page,
            }, {
                create("UICorner", { CornerRadius = UDim.new(0, 7) }),
                create("UIStroke", { Thickness = 1, Color = Theme.Stroke }),
            })

            local TopBtn = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamSemibold,
                Text = "  " .. tostring(name) .. ":  [" .. tostring(current) .. "]  ▼",
                TextColor3 = Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 3,
                Parent = Container,
            })

            local OptionList = create("Frame", {
                Size = UDim2.new(1, -16, 0, 0),
                Position = UDim2.fromOffset(8, 40),
                BackgroundTransparency = 1,
                ZIndex = 3,
                Parent = Container,
            }, {
                create("UIListLayout", { Padding = UDim.new(0, 4) }),
            })

            local function rebuild(newOpts)
                options = newOpts or options
                for _, ch in ipairs(OptionList:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end
                for _, opt in ipairs(options) do
                    local OBtn = create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 26),
                        BackgroundColor3 = Theme.PanelAlt,
                        Font = Enum.Font.GothamSemibold,
                        Text = tostring(opt),
                        TextColor3 = Theme.Text,
                        TextSize = 11,
                        ZIndex = 4,
                        Parent = OptionList,
                    }, {
                        create("UICorner", { CornerRadius = UDim.new(0, 5) }),
                    })
                    OBtn.MouseButton1Click:Connect(function()
                        current = opt
                        TopBtn.Text = "  " .. tostring(name) .. ":  [" .. tostring(current) .. "]  ▼"
                        isOpen = false
                        Container.Size = UDim2.new(1, 0, 0, 38)
                        if callback then task.spawn(callback, current) end
                    end)
                end
                if isOpen then
                    Container.Size = UDim2.new(1, 0, 0, 44 + (#options * 30))
                end
            end

            TopBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                Container.Size = isOpen and UDim2.new(1, 0, 0, 44 + (#options * 30)) or UDim2.new(1, 0, 0, 38)
            end)

            rebuild(options)

            return {
                Refresh = function(_, newList) rebuild(newList) end,
                Set = function(_, val)
                    current = val
                    TopBtn.Text = "  " .. tostring(name) .. ":  [" .. tostring(current) .. "]  ▼"
                    if callback then task.spawn(callback, current) end
                end
            }
        end

        function Tab:AddKeybind(c)
            local cfg = c or {}
            local name = cfg.Name or cfg.Title or cfg.Text or "Keybind"
            local keyName = cfg.CurrentKeybind or (typeof(cfg.Default) == "EnumItem" and cfg.Default.Name) or cfg.Default or "E"
            local currentKey = typeof(cfg.Default) == "EnumItem" and cfg.Default or (Enum.KeyCode[tostring(keyName)] or Enum.KeyCode.E)
            local binding = false

            local Card = create("Frame", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = Theme.Element,
                BackgroundTransparency = 0.12,
                ZIndex = 3,
                Parent = Page,
            }, {
                create("UICorner", { CornerRadius = UDim.new(0, 7) }),
                create("UIStroke", { Thickness = 1, Color = Theme.Stroke }),
            })

            create("TextLabel", {
                Size = UDim2.new(1, -100, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamSemibold,
                Text = tostring(name),
                TextColor3 = Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 3,
                Parent = Card,
            })

            local KeyBtn = create("TextButton", {
                Size = UDim2.fromOffset(78, 24),
                Position = UDim2.new(1, -88, 0.5, -12),
                BackgroundColor3 = Theme.PanelAlt,
                Font = Enum.Font.GothamBold,
                Text = "[" .. tostring(currentKey.Name) .. "]",
                TextColor3 = Theme.Accent,
                TextSize = 11,
                ZIndex = 3,
                Parent = Card,
            }, {
                create("UICorner", { CornerRadius = UDim.new(0, 5) }),
            })

            KeyBtn.MouseButton1Click:Connect(function()
                binding = true
                KeyBtn.Text = "[...]"
            end)

            track(UserInputService.InputBegan:Connect(function(input, gpe)
                if binding then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey = input.KeyCode
                        KeyBtn.Text = "[" .. currentKey.Name .. "]"
                        binding = false
                        if cfg.OnChange then pcall(cfg.OnChange, currentKey) end
                    end
                    return
                end
                if not gpe and UserInputService:GetFocusedTextBox() == nil then
                    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey then
                        if cfg.Callback then task.spawn(cfg.Callback, currentKey) end
                    end
                end
            end))
        end

        function Tab:AddInput(c)
            local cfg = c or {}
            local name = cfg.Name or cfg.Title or cfg.Text or "Input"
            local Card = create("Frame", {
                Size = UDim2.new(1, 0, 0, 40),
                BackgroundColor3 = Theme.Element,
                BackgroundTransparency = 0.12,
                ZIndex = 3,
                Parent = Page,
            }, {
                create("UICorner", { CornerRadius = UDim.new(0, 7) }),
                create("UIStroke", { Thickness = 1, Color = Theme.Stroke }),
            })

            create("TextLabel", {
                Size = UDim2.new(0.46, -12, 1, 0),
                Position = UDim2.fromOffset(12, 0),
                BackgroundTransparency = 1,
                Font = Enum.Font.GothamSemibold,
                Text = tostring(name),
                TextColor3 = Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 3,
                Parent = Card,
            })

            local Box = create("TextBox", {
                Size = UDim2.new(0.52, -12, 0, 26),
                Position = UDim2.new(0.48, 0, 0.5, -13),
                BackgroundColor3 = Theme.PanelAlt,
                Font = Enum.Font.Gotham,
                PlaceholderText = tostring(cfg.PlaceholderText or "Nhập..."),
                PlaceholderColor3 = Theme.SubText,
                Text = "",
                TextColor3 = Theme.Text,
                TextSize = 11,
                ClearTextOnFocus = false,
                ZIndex = 3,
                Parent = Card,
            }, {
                create("UICorner", { CornerRadius = UDim.new(0, 5) }),
            })

            Box.FocusLost:Connect(function()
                local txt = Box.Text
                if cfg.RemoveTextAfterFocusLost then Box.Text = "" end
                if cfg.Callback then task.spawn(cfg.Callback, txt) end
            end)
        end

        function Tab:AddColorPicker(c)
            local cfg = c or {}
            local name = cfg.Name or cfg.Title or "Color Picker"
            local colors = {
                Color3.fromRGB(255, 200, 60),
                Color3.fromRGB(0, 229, 255),
                Color3.fromRGB(170, 80, 255),
                Color3.fromRGB(70, 220, 130),
                Color3.fromRGB(255, 70, 90),
                Color3.fromRGB(255, 255, 255),
            }
            local idx = 1

            local Btn = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = Theme.Element,
                BackgroundTransparency = 0.12,
                Font = Enum.Font.GothamSemibold,
                Text = "  🎨  " .. tostring(name),
                TextColor3 = Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
                ZIndex = 3,
                Parent = Page,
            }, {
                create("UICorner", { CornerRadius = UDim.new(0, 7) }),
                create("UIStroke", { Thickness = 1, Color = Theme.Stroke }),
            })

            local Preview = create("Frame", {
                Size = UDim2.fromOffset(22, 22),
                Position = UDim2.new(1, -34, 0.5, -11),
                BackgroundColor3 = cfg.Color or colors[1],
                ZIndex = 4,
                Parent = Btn,
            }, {
                create("UICorner", { CornerRadius = UDim.new(1, 0) }),
            })

            Btn.MouseButton1Click:Connect(function()
                idx = (idx % #colors) + 1
                Preview.BackgroundColor3 = colors[idx]
                if cfg.Callback then task.spawn(cfg.Callback, colors[idx]) end
            end)
        end

        -- Cầu nối tương thích 100% với Rayfield / Fluent / Linoria trong 12 Tab
        Tab.CreateSection     = Tab.AddSection
        Tab.CreateParagraph   = Tab.AddLabel
        Tab.AddParagraph      = Tab.AddLabel
        Tab.CreateButton      = Tab.AddButton
        Tab.CreateToggle      = Tab.AddToggle
        Tab.CreateSlider      = Tab.AddSlider
        Tab.CreateDropdown    = Tab.AddDropdown
        Tab.CreateKeybind     = Tab.AddKeybind
        Tab.CreateInput       = Tab.AddInput
        Tab.CreateColorPicker = Tab.AddColorPicker
        Tab.AddLeftGroupbox   = function(self, grpName) self:AddSection(grpName) return self end
        Tab.AddRightGroupbox  = function(self, grpName) self:AddSection(grpName) return self end

        return Tab
    end

    return Window
end

