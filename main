                create("UIStroke", { Thickness = 1, Color = Theme.Stroke }),
            })

            create("TextLabel", {
                Size = UDim2.new(1, -95, 0, 20),
                Position = UDim2.fromOffset(12, 5),
                BackgroundTransparency = 1,
