    function TabAPI:CreateToggle(cfg)
        cfg = cfg or {}
        local state = cfg.CurrentValue or cfg.Default or false

        local Card = Instance.new("TextButton")
        Card.Size = UDim2.new(1, 0, 0, 36)
        Card.BackgroundColor3 = UI_Settings.CardColor
        Card.BackgroundTransparency = 0.15
        Card.Text = ""
        Card.AutoButtonColor = false
        Card.ZIndex = 3
        Card.Parent = Page
        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 6)

        local Lbl = Instance.new("TextLabel", Card)
        Lbl.Size = UDim2.new(1, -65, 1, 0)
        Lbl.Position = UDim2.fromOffset(10, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.Text = tostring(cfg.Name or cfg.Text or "Toggle")
        Lbl.TextColor3 = UI_Settings.TextColor
        Lbl.TextSize = 12
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.ZIndex = 3

        local Switch = Instance.new("Frame", Card)
        Switch.Size = UDim2.fromOffset(40, 20)
        Switch.Position = UDim2.new(1, -50, 0.5, -10)
        Switch.BackgroundColor3 = state and UI_Settings.AccentColor or Color3.fromRGB(50, 50, 65)
        Switch.ZIndex = 3
        Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

        local Knob = Instance.new("Frame", Switch)
        Knob.Size = UDim2.fromOffset(14, 14)
        Knob.Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
        Knob.BackgroundColor3 = Color3.new(1, 1, 1)
        Knob.ZIndex = 4
        Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

        local function setToggle(val)
            state = val
            TweenService:Create(Switch, TweenInfo.new(0.15), {
                BackgroundColor3 = state and UI_Settings.AccentColor or Color3.fromRGB(50, 50, 65)
            }):Play()
            TweenService:Create(Knob, TweenInfo.new(0.15), {
                Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
            }):Play()
            if cfg.Callback then task.spawn(cfg.Callback, state) end
        end

        Card.MouseButton1Click:Connect(function() setToggle(not state) end)
        return { Set = setToggle }
    end

    function TabAPI:CreateSlider(cfg)
        cfg = cfg or {}
        local range = cfg.Range or { cfg.Min or 0, cfg.Max or 100 }
        local minVal, maxVal = range[1], range[2]
        local inc = cfg.Increment or 1
        local suffix = cfg.Suffix and (" " .. cfg.Suffix) or ""
        local curVal = cfg.CurrentValue or cfg.Default or minVal

        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(1, 0, 0, 48)
        Card.BackgroundColor3 = UI_Settings.CardColor
        Card.BackgroundTransparency = 0.15
        Card.ZIndex = 3
        Card.Parent = Page
        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 6)

        local Lbl = Instance.new("TextLabel", Card)
        Lbl.Size = UDim2.new(1, -90, 0, 20)
        Lbl.Position = UDim2.fromOffset(10, 4)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.Text = tostring(cfg.Name or cfg.Text or "Slider")
        Lbl.TextColor3 = UI_Settings.TextColor
        Lbl.TextSize = 12
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.ZIndex = 3

        local ValLbl = Instance.new("TextLabel", Card)
        ValLbl.Size = UDim2.fromOffset(80, 20)
        ValLbl.Position = UDim2.new(1, -90, 0, 4)
        ValLbl.BackgroundTransparency = 1
        ValLbl.Font = Enum.Font.GothamBold
        ValLbl.Text = tostring(curVal) .. suffix
        ValLbl.TextColor3 = UI_Settings.AccentColor
        ValLbl.TextSize = 12
        ValLbl.TextXAlignment = Enum.TextXAlignment.Right
        ValLbl.ZIndex = 3

        local BarBg = Instance.new("TextButton", Card)
        BarBg.Size = UDim2.new(1, -20, 0, 8)
        BarBg.Position = UDim2.fromOffset(10, 30)
        BarBg.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
        BarBg.Text = ""
        BarBg.AutoButtonColor = false
        BarBg.ZIndex = 3
        Instance.new("UICorner", BarBg).CornerRadius = UDim.new(1, 0)

        local Fill = Instance.new("Frame", BarBg)
        local initAlpha = math.clamp((curVal - minVal) / math.max(0.0001, maxVal - minVal), 0, 1)
        Fill.Size = UDim2.new(initAlpha, 0, 1, 0)
        Fill.BackgroundColor3 = UI_Settings.AccentColor
        Fill.BorderSizePixel = 0
        Fill.ZIndex = 4
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

        local sliding = false
        local function updateFromInput(inputPos)
            local relX = math.clamp((inputPos.X - BarBg.AbsolutePosition.X) / math.max(1, BarBg.AbsoluteSize.X), 0, 1)
            local raw = minVal + (maxVal - minVal) * relX
            local snapped = math.floor((raw / inc) + 0.5) * inc
            snapped = tonumber(string.format("%.2f", math.clamp(snapped, minVal, maxVal)))
            curVal = snapped
            local alpha = (curVal - minVal) / math.max(0.0001, maxVal - minVal)
            Fill.Size = UDim2.new(alpha, 0, 1, 0)
            ValLbl.Text = tostring(curVal) .. suffix
            if cfg.Callback then task.spawn(cfg.Callback, curVal) end
        end

        BarBg.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                updateFromInput(input.Position)
            end
        end)
        trackConn(UserInputService.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromInput(input.Position)
            end
        end))
        trackConn(UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = false
            end
        end))
    end

    function TabAPI:CreateDropdown(cfg)
        cfg = cfg or {}
        local options = cfg.Options or {"None"}
        local current = cfg.CurrentOption or options[1] or "None"
        if type(current) == "table" then current = current[1] end
        local isOpen = false

        local Container = Instance.new("Frame")
        Container.Size = UDim2.new(1, 0, 0, 36)
        Container.BackgroundColor3 = UI_Settings.CardColor
        Container.BackgroundTransparency = 0.15
        Container.ClipsDescendants = true
        Container.ZIndex = 3
        Container.Parent = Page
        Instance.new("UICorner", Container).CornerRadius = UDim.new(0, 6)

        local TopBtn = Instance.new("TextButton", Container)
        TopBtn.Size = UDim2.new(1, 0, 0, 36)
        TopBtn.BackgroundTransparency = 1
        TopBtn.Font = Enum.Font.GothamSemibold
        TopBtn.Text = "  " .. tostring(cfg.Name or "Dropdown") .. ":  [" .. tostring(current) .. "]  ▼"
        TopBtn.TextColor3 = UI_Settings.TextColor
        TopBtn.TextSize = 12
        TopBtn.TextXAlignment = Enum.TextXAlignment.Left
        TopBtn.ZIndex = 3

        local OptionList = Instance.new("Frame", Container)
        OptionList.Size = UDim2.new(1, -12, 0, 0)
        OptionList.Position = UDim2.fromOffset(6, 38)
        OptionList.BackgroundTransparency = 1
        OptionList.ZIndex = 3
        local OptLayout = Instance.new("UIListLayout", OptionList)
        OptLayout.Padding = UDim.new(0, 4)

        local function rebuildOptions(newOpts)
            options = newOpts or options
            for _, child in ipairs(OptionList:GetChildren()) do
                if child:IsA("TextButton") then child:Destroy() end
            end
            for _, opt in ipairs(options) do
                local OBtn = Instance.new("TextButton", OptionList)
                OBtn.Size = UDim2.new(1, 0, 0, 26)
                OBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
                OBtn.Font = Enum.Font.Gotham
                OBtn.Text = tostring(opt)
                OBtn.TextColor3 = UI_Settings.TextColor
                OBtn.TextSize = 11
                OBtn.ZIndex = 4
                Instance.new("UICorner", OBtn).CornerRadius = UDim.new(0, 4)

                OBtn.MouseButton1Click:Connect(function()
                    current = opt
                    TopBtn.Text = "  " .. tostring(cfg.Name or "Dropdown") .. ":  [" .. tostring(current) .. "]  ▼"
                    isOpen = false
                    Container.Size = UDim2.new(1, 0, 0, 36)
                    if cfg.Callback then task.spawn(cfg.Callback, current) end
                end)
            end
            if isOpen then Container.Size = UDim2.new(1, 0, 0, 42 + (#options * 30)) end
        end

        TopBtn.MouseButton1Click:Connect(function()
            isOpen = not isOpen
            Container.Size = isOpen and UDim2.new(1, 0, 0, 42 + (#options * 30)) or UDim2.new(1, 0, 0, 36)
        end)
        rebuildOptions(options)
        return {
            Refresh = function(_, newList) rebuildOptions(newList) end,
            Set = function(_, val)
                current = val
                TopBtn.Text = "  " .. tostring(cfg.Name or "Dropdown") .. ":  [" .. tostring(current) .. "]  ▼"
                if cfg.Callback then task.spawn(cfg.Callback, current) end
            end
        }
    end

    function TabAPI:CreateKeybind(cfg)
        cfg = cfg or {}
        local keyName = cfg.CurrentKeybind or "None"
        local currentKey = Enum.KeyCode[keyName] or Enum.KeyCode.Unknown
        local binding = false

        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(1, 0, 0, 36)
        Card.BackgroundColor3 = UI_Settings.CardColor
        Card.BackgroundTransparency = 0.15
        Card.ZIndex = 3
        Card.Parent = Page
        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 6)

        local Lbl = Instance.new("TextLabel", Card)
        Lbl.Size = UDim2.new(1, -100, 1, 0)
        Lbl.Position = UDim2.fromOffset(10, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.Text = tostring(cfg.Name or "Keybind")
        Lbl.TextColor3 = UI_Settings.TextColor
        Lbl.TextSize = 12
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.ZIndex = 3

        local KeyBtn = Instance.new("TextButton", Card)
        KeyBtn.Size = UDim2.fromOffset(75, 24)
        KeyBtn.Position = UDim2.new(1, -85, 0.5, -12)
        KeyBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 62)
        KeyBtn.Font = Enum.Font.GothamBold
        KeyBtn.Text = "[" .. tostring(keyName) .. "]"
        KeyBtn.TextColor3 = UI_Settings.AccentColor
        KeyBtn.TextSize = 11
        KeyBtn.ZIndex = 3
        Instance.new("UICorner", KeyBtn).CornerRadius = UDim.new(0, 4)

        KeyBtn.MouseButton1Click:Connect(function()
            binding = true
            KeyBtn.Text = "[...]"
        end)

        trackConn(UserInputService.InputBegan:Connect(function(input, gpe)
            if binding then
                if input.UserInputType == Enum.UserInputType.Keyboard then
                    currentKey = input.KeyCode
                    keyName = input.KeyCode.Name
                    KeyBtn.Text = "[" .. keyName .. "]"
                    binding = false
                end
                return
            end
            if not gpe and UserInputService:GetFocusedTextBox() == nil then
                if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == currentKey then
                    if cfg.Callback then task.spawn(cfg.Callback) end
                end
            end
        end))
    end

    function TabAPI:CreateInput(cfg)
        cfg = cfg or {}
        local Card = Instance.new("Frame")
        Card.Size = UDim2.new(1, 0, 0, 40)
        Card.BackgroundColor3 = UI_Settings.CardColor
        Card.BackgroundTransparency = 0.15
        Card.ZIndex = 3
        Card.Parent = Page
        Instance.new("UICorner", Card).CornerRadius = UDim.new(0, 6)

        local Lbl = Instance.new("TextLabel", Card)
        Lbl.Size = UDim2.new(0.45, -10, 1, 0)
        Lbl.Position = UDim2.fromOffset(10, 0)
        Lbl.BackgroundTransparency = 1
        Lbl.Font = Enum.Font.GothamSemibold
        Lbl.Text = tostring(cfg.Name or "Input")
        Lbl.TextColor3 = UI_Settings.TextColor
        Lbl.TextSize = 12
        Lbl.TextXAlignment = Enum.TextXAlignment.Left
        Lbl.ZIndex = 3

        local Box = Instance.new("TextBox", Card)
        Box.Size = UDim2.new(0.52, -10, 0, 26)
        Box.Position = UDim2.new(0.48, 0, 0.5, -13)
        Box.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
        Box.Font = Enum.Font.Gotham
        Box.PlaceholderText = tostring(cfg.PlaceholderText or "Nhập...")
        Box.PlaceholderColor3 = Color3.fromRGB(130, 130, 150)
        Box.Text = ""
        Box.TextColor3 = UI_Settings.TextColor
        Box.TextSize = 11
        Box.ClearTextOnFocus = false
        Box.ZIndex = 3
        Instance.new("UICorner", Box).CornerRadius = UDim.new(0, 4)

        Box.FocusLost:Connect(function()
            local txt = Box.Text
            if cfg.RemoveTextAfterFocusLost then Box.Text = "" end
            if cfg.Callback then task.spawn(cfg.Callback, txt) end
        end)
    end

    function TabAPI:CreateColorPicker(cfg)
        cfg = cfg or {}
        local presetColors = {
            Color3.fromRGB(255, 200, 60), Color3.fromRGB(160, 80, 255),
            Color3.fromRGB(0, 230, 255), Color3.fromRGB(50, 255, 130),
            Color3.fromRGB(255, 65, 85), Color3.fromRGB(255, 255, 255)
        }
        local idx = 1

        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, 0, 0, 36)
        Btn.BackgroundColor3 = UI_Settings.CardColor
        Btn.BackgroundTransparency = 0.15
        Btn.Font = Enum.Font.GothamSemibold
        Btn.Text = "  🎨  " .. tostring(cfg.Name or "Color Picker") .. " (Bấm đổi màu)"
        Btn.TextColor3 = UI_Settings.TextColor
        Btn.TextSize = 12
        Btn.TextXAlignment = Enum.TextXAlignment.Left
        Btn.AutoButtonColor = false
        Btn.ZIndex = 3
        Btn.Parent = Page
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)

        local Preview = Instance.new("Frame", Btn)
        Preview.Size = UDim2.fromOffset(22, 22)
        Preview.Position = UDim2.new(1, -32, 0.5, -11)
        Preview.BackgroundColor3 = cfg.Color or presetColors[1]
        Preview.ZIndex = 4
        Instance.new("UICorner", Preview).CornerRadius = UDim.new(1, 0)

        Btn.MouseButton1Click:Connect(function()
            idx = (idx % #presetColors) + 1
            local chosen = presetColors[idx]
            Preview.BackgroundColor3 = chosen
            if cfg.Callback then task.spawn(cfg.Callback, chosen) end
        end)
    end

    TabAPI.AddButton = TabAPI.CreateButton
    TabAPI.AddToggle = function(self, flag, opts)
        opts = opts or {}
        opts.Name = opts.Title or opts.Text or flag
        return self:CreateToggle(opts)
    end
    TabAPI.AddSlider = function(self, flag, opts)
        opts = opts or {}
        opts.Name = opts.Title or opts.Text or flag
        return self:CreateSlider(opts)
    end

    return TabAPI
end

