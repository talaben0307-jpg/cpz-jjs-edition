local env = (getgenv and getgenv()) or _G
if env.ZelynxCPZ_Cleanup then
    pcall(env.ZelynxCPZ_Cleanup)
end

local function getSafeGuiParent()
    if gethui then
        local ok, res = pcall(gethui)
        if ok and res then return res end
    end
    local ok, core = pcall(function() return CoreGui end)
    if ok and core then return core end
    return LocalPlayer:WaitForChild("PlayerGui", 5)
end

local guiParent = getSafeGuiParent()
local connections = {}
local spinners = {}

local function track(conn)
    table.insert(connections, conn)
    return conn
end

local function Notify(title, text, dur)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "CPZ Menu | Zelynx",
            Text = text or "",
            Duration = dur or 3
        })
    end)
end

local requestFn = (syn and syn.request) or (http and http.request) or http_request or request
local function httpGet(url)
    if requestFn then
        local ok, res = pcall(requestFn, { Url = url, Method = "GET" })
        if ok and res and res.StatusCode == 200 and res.Body then return res.Body end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    return ok and body or nil
end

